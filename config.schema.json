          "minItems": 0,
          "maxItems": 6
        },
        "chains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "version",
        "device",
        "wifi",
        "mqtt",
        "modeTopic",
        "uart0",
        "externalJtag",
        "allowStrapping",
        "servos",
        "chains",
        "groups",
        "bindings"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
